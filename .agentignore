# .agentignore — GIT-001 (30. Política de Control de Versiones)
# El agente NO DEBE añadir, modificar ni eliminar archivos listados aquí.
# Incluye todos los patrones de .gitignore más los específicos del agente.

# Build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Dependencies
node_modules
.venv

# Logs
logs
*.log
*.out
*.err

# Env and secrets
.env
.env.*
!.env.example
*.secret
*.pem
*.key
*.cer
*.crt
*.pkcs12

# Editor and OS
.vscode
.idea
.fleet
.DS_Store
Thumbs.db
*.local

# Test and coverage
coverage
*.test.log

# Local references (capturas, mood board, notas locales)
referencias/

# Playwright MCP artifacts
.playwright-mcp/

# Local dev screenshots
*.png

# --- Específicos del agente ---

# Archivos de diálogo o conversación
*_dialog.md
*_chat.log
conversation_*.txt
*_prompt_*.md

# Archivos temporales del agente
*.tmp
*.cache
*.draft

# Memoria del Proyecto (24) — no versionada por instrucción del usuario
13_DECISION_LOG.md
14_KNOWN_PROBLEMS.md
15_OPEN_QUESTIONS.md
16_ARCHITECTURE_DECISIONS.md
